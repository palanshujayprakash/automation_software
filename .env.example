# ==========================================================
# FlowPilot AI Automation Dashboard — Environment Template
# NEVER commit sensitive API keys, secrets, or real credentials.
# ==========================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Safe for browser / client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Secret (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Token & Secret Encryption (Server-side AES-256 key for OAuth refresh tokens)
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET_KEY=replace-with-64-character-hex-key-for-aes-256

# Google OAuth 2.0 Credentials (Server-side)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# LLM API (Server-side only for structured workflow generation)
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-2.5-flash
